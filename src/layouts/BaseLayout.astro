---
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import HeaderLayout from './HeaderLayout.astro';
import FooterLayout from './FooterLayout.astro';
import Seo from '../components/Seo.astro';
import { SITE_LANG } from '../lib/site';

interface Props {
  pageTitle?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  showTitle?: boolean;
}

const { pageTitle = '', description, ogType, publishedTime, showTitle = Boolean(pageTitle) } = Astro.props;
const scrollThreshold = 300;
---

<html lang={SITE_LANG} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={pageTitle} description={description} ogType={ogType} publishedTime={publishedTime} />
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-stone-50 text-gray-800 transition-colors duration-300 dark:bg-neutral-900 dark:text-gray-200"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-gray-900 focus:ring-2 focus:ring-blue-400 dark:focus:bg-neutral-800 dark:focus:text-gray-100"
    >
      跳到正文
    </a>
    <HeaderLayout />
    <main id="main" class="mx-auto w-full max-w-4xl flex-grow px-4 py-8">
      {showTitle && <h1 class="mb-8 font-serif text-3xl font-bold text-gray-900 dark:text-gray-100">{pageTitle}</h1>}
      <slot />
    </main>
    <button
      id="back-to-top"
      type="button"
      aria-label="回到顶部"
      tabindex="-1"
      class="invisible fixed bottom-8 right-8 inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-blue-500 text-white opacity-0 shadow-lg transition-all duration-300 hover:bg-blue-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 dark:bg-blue-600 dark:hover:bg-blue-500"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>
    <FooterLayout />
    <script is:inline define:vars={{ scrollThreshold }}>
      document.addEventListener('DOMContentLoaded', () => {
        const backToTopButton = document.getElementById('back-to-top');
        if (!backToTopButton) return;

        const sync = () => {
          const visible = window.scrollY > scrollThreshold;
          backToTopButton.classList.toggle('opacity-100', visible);
          backToTopButton.classList.toggle('visible', visible);
          backToTopButton.classList.toggle('opacity-0', !visible);
          backToTopButton.classList.toggle('invisible', !visible);
          backToTopButton.tabIndex = visible ? 0 : -1;
        };

        sync();
        window.addEventListener('scroll', sync, { passive: true });
        backToTopButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    </script>
  </body>
</html>
