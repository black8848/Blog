---
import { formatPostDate } from '../lib/dates';

interface Props {
  href: string;
  title: string;
  date: Date;
}

const { href, title, date } = Astro.props;
const formattedDate = formatPostDate(date);
---

<div class="mb-4 flex items-baseline justify-between space-x-8 text-xl font-semibold">
  <a
    href={href}
    class="min-w-0 cursor-pointer font-serif text-gray-800 no-underline transition-colors duration-200 hover:text-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 dark:text-gray-200 dark:hover:text-blue-400"
  >
    {title}
  </a>
  <time
    datetime={formattedDate}
    class="shrink-0 font-mono font-normal text-gray-500 dark:text-gray-400"
  >
    {formattedDate}
  </time>
</div>
