---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<ul class="space-y-2">
  {
    headings.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          data-slug={heading.slug}
          class:list={[
            'toc-link block py-1 text-gray-500 transition-colors hover:text-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 dark:text-gray-400 dark:hover:text-blue-400',
            heading.depth === 2 && 'pl-0',
            heading.depth === 3 && 'pl-3',
            heading.depth === 4 && 'pl-6 text-xs',
          ]}
        >
          {heading.text}
        </a>
      </li>
    ))
  }
</ul>
