---
import type { MarkdownHeading } from 'astro';
import TocLinks from './TocLinks.astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const minDepth = 2;
const maxDepth = 4;
const toc = headings.filter((heading) => heading.depth >= minDepth && heading.depth <= maxDepth);
---

{
  toc.length > 0 && (
    <nav
      class="toc not-prose fixed top-24 left-[calc(50%+31rem)] hidden w-56 text-sm xl:block"
      aria-label="目录"
    >
      <p class="mb-3 font-semibold text-gray-700 dark:text-gray-300">目录</p>
      <TocLinks headings={toc} />
    </nav>
  )
}

<script>
  const rootMargin = '-80px 0px -70% 0px';

  function initToc() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const headings = [
      ...new Map(
        Array.from(tocLinks)
          .map((link) => document.getElementById(link.dataset.slug ?? ''))
          .filter((heading): heading is HTMLElement => heading !== null)
          .map((heading) => [heading.id, heading]),
      ).values(),
    ];

    if (headings.length === 0) return;

    const setActive = (slug: string) => {
      tocLinks.forEach((link) => {
        const active = link.dataset.slug === slug;
        link.classList.toggle('text-blue-500', active);
        link.classList.toggle('dark:text-blue-400', active);
        link.classList.toggle('font-medium', active);
        link.classList.toggle('text-gray-500', !active);
        link.classList.toggle('dark:text-gray-400', !active);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin, threshold: 0 },
    );

    headings.forEach((heading) => observer.observe(heading));
  }

  initToc();
</script>
