---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { groupPostsByYear, postPath, publishedPosts } from '../lib/posts';

const posts = await publishedPosts();
const years = groupPostsByYear(posts);
const yearDelayMs = 100;
const postDelayMs = 50;
---

<BaseLayout showTitle={false}>
  <h1 class="sr-only">全部文章</h1>
  {
    years.map((group, yearIndex) => (
      <section class="mb-10 animate-fade-in" style={`animation-delay: ${yearIndex * yearDelayMs}ms`}>
        <h2 class="mb-8 font-serif text-3xl font-bold text-gray-600 dark:text-gray-400">{group.year}</h2>
        <div class="space-y-4">
          {group.posts.map((post, postIndex) => (
            <div
              class="animate-fade-in"
              style={`animation-delay: ${yearIndex * yearDelayMs + (postIndex + 1) * postDelayMs}ms`}
            >
              <BlogPost href={postPath(post)} title={post.data.title} date={post.data.pubDate} />
            </div>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
