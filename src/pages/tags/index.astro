---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/posts';
import { tagPalette, tagPath } from '../../lib/tags';

const posts = await publishedPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort(
  (left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'),
);
const pageTitle = '标签分类';
---

<BaseLayout pageTitle={pageTitle} description="浏览所有标签分类，点击标签查看相关文章。">
  <p class="mb-8 text-gray-600 dark:text-gray-400">浏览所有标签分类，点击标签查看相关文章。</p>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      tags.map(([tag, count]) => {
        const palette = tagPalette(tag);
        return (
          <a
            href={tagPath(tag)}
            class:list={[
              'flex min-h-11 cursor-pointer items-center justify-between gap-3 rounded-lg border px-4 py-3 no-underline shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400',
              palette.card,
            ]}
          >
            <span class="truncate text-lg font-medium">{tag}</span>
            <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-xs font-medium', palette.badge]}>
              {count}
            </span>
          </a>
        );
      })
    }
  </div>
</BaseLayout>
