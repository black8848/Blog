---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="页面不存在" showTitle={false}>
  <h1 class="font-serif text-3xl font-bold text-gray-900 dark:text-gray-100">页面不存在</h1>
  <p class="mt-4 text-gray-600 dark:text-gray-400">这个地址没有对应的页面。</p>
  <a
    href="/"
    class="mt-6 inline-flex min-h-11 items-center text-blue-600 no-underline hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 dark:text-blue-400"
  >
    返回首页
  </a>
</BaseLayout>
